// ──────────────────────────────────────────────────────────────────────
// NGO Connect — Prisma Schema (SQLite Version)
// ──────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── User ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  name         String?
  avatar       String?
  role         String   @default("REPORTER") // Was Enum Role
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  ngoProfile    NGOProfile?
  reportedCases Case[]        @relation("ReporterCases")
  activityLogs  ActivityLog[]
  medicines     Medicine[]
  donations     Donation[]

  @@map("users")
}

// ─── NGO Profile ──────────────────────────────────────────────────────

model NGOProfile {
  id                 String  @id @default(uuid())
  userId             String  @unique @map("user_id")
  orgName            String  @map("org_name")
  verificationStatus Boolean @default(false) @map("verification_status")
  latitude           Float   @default(0)
  longitude          Float   @default(0)
  rescueStats        String  @default("{}") @map("rescue_stats") // Was Json
  rating             Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCases Case[] @relation("AssignedNGOCases")

  @@map("ngo_profiles")
}

// ─── Case (Report & Rescue) ──────────────────────────────────────────

model Case {
  id            String      @id @default(uuid())
  reporterId    String?     @map("reporter_id")
  assignedNgoId String?     @map("assigned_ngo_id")
  latitude      Float       @default(0)
  longitude     Float       @default(0)
  urgency       String      @default("MODERATE") // Was Enum CaseUrgency
  status        String      @default("OPEN") // Was Enum CaseStatus
  description   String
  images        String      @default("[]") // Was String[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  reporter     User?        @relation("ReporterCases", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedNgo  NGOProfile?  @relation("AssignedNGOCases", fields: [assignedNgoId], references: [id], onDelete: SetNull)
  activityLogs ActivityLog[]
  donations    Donation[]

  @@map("cases")
}

// ─── Activity Log (Append-Only Audit Trail) ──────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  actorId    String   @map("actor_id")
  actionType String   @map("action_type")
  metadata   String   @default("{}") @map("metadata") // Was Json
  timestamp  DateTime @default(now())

  // Relations
  case  Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

// ─── Medicine ─────────────────────────────────────────────────────────

model Medicine {
  id         String         @id @default(uuid())
  donorId    String?        @map("donor_id")
  name       String
  expiryDate DateTime       @map("expiry_date")
  type       String
  latitude   Float          @default(0)
  longitude  Float          @default(0)
  status     String         @default("AVAILABLE") // Was Enum MedicineStatus
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  // Relations
  donor User? @relation(fields: [donorId], references: [id], onDelete: SetNull)

  @@map("medicines")
}

// ─── Donation ─────────────────────────────────────────────────────────

model Donation {
  id            String   @id @default(uuid())
  donorId       String   @map("donor_id")
  caseId        String?  @map("case_id")
  amount        Float
  currency      String   @default("INR")
  transactionId String   @unique @map("transaction_id")
  timestamp     DateTime @default(now())

  // Relations
  donor User  @relation(fields: [donorId], references: [id], onDelete: Cascade)
  case  Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@map("donations")
}
